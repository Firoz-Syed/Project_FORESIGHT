{
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "foreground": "#6A9955"
        }
      },
      {
        "scope": "entity.name.function",
        "settings": {
          "foreground": "#DCDCAA"
        }
      },
      {
        "scope": "keyword",
        "settings": {
          "foreground": "#569CD6"
        }
      }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "rules": {
      "*.default": {
        "foreground": "#ffffff"
      },
      "variable.defaultLibrary": {
        "foreground": "#ffffff"
      },
      "function.defaultLibrary": {
        "foreground": "#ffffff"
      }
    }
  }
}
